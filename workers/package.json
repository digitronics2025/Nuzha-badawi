{
  "name": "nusya-cloudflare-platform",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build:frontend": "python3 ../frontend/scripts/build.py",
    "test": "node --test tests/*.test.mjs",
    "test:sql": "python3 tools/check_migrations.py",
    "check": "npm run test:sql && npm test && node --check public/src/index.js && node --check admin/src/index.js",
    "dev:public": "npx wrangler dev --config public/wrangler.jsonc",
    "dev:admin": "npx wrangler dev --config admin/wrangler.jsonc"
  },
  "engines": { "node": ">=22" },
  "devDependencies": { "wrangler": "^4.0.0" },
  "license": "UNLICENSED"
}
