{
  // TEMPLATE ONLY — no account resources or production DNS are provisioned.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nusya-public",
  "main": "./src/index.js",
  "compatibility_date": "2026-11-15",
  "workers_dev": false,
  "assets": {
    "directory": "../../frontend/dist-public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/media/*", "/en/*", "/ar/*", "/ru/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "nusya-platform",
    "database_id": "REPLACE_WITH_VERIFIED_D1_DATABASE_UUID",
    "migrations_dir": "../migrations"
  }],
  "vars": {
    "PUBLIC_HOST": "nozha-badavi.com",
    "TURNSTILE_SITE_KEY": "REPLACE_WITH_PUBLIC_TURNSTILE_SITE_KEY",
    "NOTIFICATION_EMAIL": "REPLACE_WITH_VERIFIED_DESTINATION_EMAIL",
    "EMAIL_FROM": "REPLACE_WITH_APPROVED_SENDER_EMAIL",
    "ENABLE_OUTBOX_CRON": "false"
  }
  // Optional: add restricted send_email binding after the approved recipient is verified.
  // Optional: add R2 binding MEDIA only after its private bucket is approved.
  // Optional: add a cron trigger (e.g. every 15 min) only if retry volume warrants it.
}
